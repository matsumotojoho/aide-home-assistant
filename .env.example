# ============================================================
# Aide — 環境変数テンプレート
# 実際の値は .env に置く。.env は絶対にコミットしない。
# `npm run setup -- <ログインパスワード>` で自動生成できる。
# ============================================================

# --- Server ---
PORT=8787
# SQLite等の永続データ置き場 (Railwayでは Persistent Volume のマウント先を指定: /data)
DATA_DIR=./data
# 本番では NODE_ENV=production
NODE_ENV=development
# 公開URL (Web Push / PWA用。Railwayなら https://xxx.up.railway.app)
PUBLIC_URL=http://localhost:8787

# --- 認証 (単一ユーザー) ---
# セッション署名用の乱数 (openssl rand -hex 32)
SESSION_SECRET=
# ログインパスワードの bcrypt ハッシュ (init-env.ts が生成)
AUTH_PASSWORD_HASH=
# 表示用メールアドレス
AUTH_EMAIL=owner@example.com

# --- Mac Agent ---
# BackendとMac Agentの共有シークレット (openssl rand -hex 32)
AGENT_TOKEN=

# --- Home Assistant ---
# 例: http://192.168.x.x:8123 (Mac mini上で動かす場合、Railwayからは到達できないため
#     home.* ツールはMac Agent経由でプロキシされる。ローカル実行時は直接アクセス)
HA_BASE_URL=
# HAの「長期アクセストークン」(HAのユーザープロフィール画面から発行)
HA_TOKEN=

# --- Web Push (VAPID) ---
# npx web-push generate-vapid-keys で生成 (init-env.ts でも生成される)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- AI Provider ---
# 既定はClaude Code CLI (サブスクリプション枠)。有料APIは初期OFF。
# Anthropic API を設定画面で有効化した場合のみ使用される。
ANTHROPIC_API_KEY=
# OpenAI API (初期OFF / 将来用)
OPENAI_API_KEY=

# --- Mac Agent側 (apps/mac-agent の .env) ---
# AIDE_SERVER_URL=ws://localhost:8787/agent/ws
# AIDE_AGENT_TOKEN=<AGENT_TOKENと同じ値>
